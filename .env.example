# Meeting Recorder — API keys
# Copy this file to ".env" (setup.bat does this for you) and paste your keys.
# Get a key by signing up at https://berget.ai

# Required: key for Whisper transcription.
BERGET_API_KEY=your-berget-api-key

# Optional: separate key for the LLM summary step.
# Leave blank to reuse BERGET_API_KEY above.
BERGET_API_KEY2=
